# Copy to .env and adjust. Everything is optional: the stack boots without keys,
# and sources that need a key are skipped (ingest_runs.status = skipped).

# Host ports, bound to 127.0.0.1 (container ports are fixed).
# devproxy forwards aktien.localhost to the web port.
API_PORT=8090
WEB_PORT=3020

# Database (as seen from inside the compose network)
DATABASE_URL=postgres://postgres:postgres@db:5432/aktien_news?sslmode=disable

# sec.gov requires a contact address in the User-Agent; empty = SEC sources skipped.
# SEC_USER_AGENT=aktien-news admin@example.com

# How long stored article text is kept (Go duration or days); default 30d.
# TEXT_RETENTION=30d

# --- Phase 3, not used yet ---
# OPENROUTER_API_KEY=
# CLASSIFY_MODEL=
# CLASSIFY_MONTHLY_BUDGET_USD=
# ALPHAVANTAGE_API_KEY=
# MCP_AUTH_TOKEN=
