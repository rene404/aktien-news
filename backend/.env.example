# Deployment environment: development | production
# In production the app refuses to start if JWT_SECRET is left at the default.
ENVIRONMENT=development

# CORS — comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/aktien_news

# Auth
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Admin bootstrap (used by app.scripts.create_admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# External data sources
FINNHUB_API_KEY=
NEWSAPI_API_KEY=
ALPHAVANTAGE_API_KEY=

# Symbol universe scope (US = NASDAQ + NYSE)
EXCHANGES=US

# AI summaries via OpenRouter (provider-neutral gateway)
# Summaries are skipped unless BOTH a key and a model are set.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SUMMARIZE_MODEL=          # required to enable, e.g. anthropic/claude-haiku-4.5
SUMMARIZE_ENABLED=true
SUMMARIZE_BATCH_SIZE=20
