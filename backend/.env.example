# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/aktien_news

# Auth
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Admin bootstrap (used by app.scripts.create_admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# External data sources
FINNHUB_API_KEY=
NEWSAPI_API_KEY=
ALPHAVANTAGE_API_KEY=

# Symbol universe scope (US = NASDAQ + NYSE)
EXCHANGES=US
